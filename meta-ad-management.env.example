# Meta Ad Management — optional overrides (copy into your local .env)
#
# R2: R2_ENDPOINT must use the SAME Cloudflare account ID as the account where the bucket
# was created (https://<ACCOUNT_ID>.r2.cloudflarestorage.com). API tokens must be for that account.
# If uploads fail with NoSuchBucket but the bucket exists in the dashboard, check account mismatch
# or ensure forcePathStyle is enabled on the S3 client (see src/lib/r2/index.ts).
#
# R2 bucket for Meta image uploads (defaults to R2_BUCKET_NAME when unset)
R2_META_BUCKET=

# Optional public CDN base for Meta images (otherwise presigned R2 URLs are used)
R2_PUBLIC_BASE_URL_META=

# Cloudflare Stream (video uploads to /api/meta/advideos)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Optional: customer subdomain for nicer Stream URLs (e.g. customer-xxxxx.cloudflarestream.com)
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
