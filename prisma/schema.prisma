  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  asset            Asset?        @relation(fields: [assetId], references: [id])
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([sourceType])
  @@map("geo_data_sources")
}

model Prompt {
  id              String   @id @default(cuid())
  query           String
  topic           String?  @db.VarChar(255)
  topicId         String?
  reason          String?
  expectedRevenue Float?
  intent          String?  @db.VarChar(100)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  ishunted        Boolean  @default(false)

  aeo_pages AeoPage[]

  executions       PromptExecution[]
  llmTopic         LlmTopic?              @relation("LlmTopicPrompts", fields: [topicId], references: [id])
  llmPromptMetrics LlmPromptMetric[]
  revenue          PromptRevenue?
  rivalByModel     PromptRivalByModel[]
  rivalConsensus   PromptRivalConsensus[]

  @@index([intent])
  @@index([topic])
  @@index([topicId])
  @@map("llm_prompts")
}

model PromptRevenue {
  id                 String   @id @default(cuid())
  promptId           String   @unique
  monthlyPromptReach Float?
  visibilityWeight   Float?
  ctr                Float?
  cvr                Float?
  aov                Float?
  estimatedRevenue   Float?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  prompt             Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([estimatedRevenue])
  @@map("llm_prompt_revenues")
}

model PromptExecution {
  id         String     @id @default(cuid())
  promptId   String
  model      String     @db.VarChar(100)
  response   String
  executedAt DateTime   @default(now()) @db.Timestamptz(3)
  citations  Citation[]
  prompt     Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([model])
  @@index([executedAt])
  @@map("llm_prompt_executions")
}

model Citation {
  id            String          @id @default(cuid())
  executionId   String
  companyId     String?
  mentionedName String          @db.VarChar(255)
  rank          Int?
  context       String?         @db.VarChar(100)
