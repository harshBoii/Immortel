model WordPressIntegration {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  siteUrl     String
  authUrl     String
  userLogin   String
  credentials String
  siteTitle   String?
  status      String   @default("active")
  connectedAt DateTime @default(now())

  company Company @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("wordpress_integrations")
}

// ================================================================
// Meta Integration
// ================================================================

model MetaIntegration {
  id            String   @id @default(uuid())
  companyId     String   @unique
  /// AES-256 encrypted
  accessToken   String   @db.Text
  /// Format: act_XXXXXXXXX
  adAccountId   String   @db.VarChar(100)
  fbPageId      String   @db.VarChar(100)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  lastRefreshed DateTime @updatedAt @map("last_refreshed") @db.Timestamptz(3)

  // ── Ad Context (from best performing ads analysis) ──────────────
  brandVoice       Json? // extracted tone, style, hook patterns
  topAdExamples    Json? // top 5 ad copy + why they worked
  audienceInsights Json? // what targeting/demographics performed best
  avgWinningCtr    Float? // benchmark CTR for this account
  contextBuiltAt   DateTime? // when the context was last analysed

  // ── Winning Formula (from analyzed assets + metrics) ─────────────
  winningFormula        Json?     @map("winning_formula")
  winningFormulaBuiltAt DateTime? @map("winning_formula_built_at") @db.Timestamptz(3)

  // ── Relations ───────────────────────────────────────────────────
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]
  creatives MetaCreative[]
  media     MetaMedia[]
  adSets    MetaAdSet[]
  ads       MetaAd[]

  @@index([companyId])
  @@map("meta_integrations")
}

model MetaMedia {
  id                String @id @default(uuid())
  metaIntegrationId String
  kind              String @db.VarChar(10) // "image" | "video"

  imageHash String? @db.VarChar(200)
  videoId   String? @db.VarChar(100)

  assetId String? @unique

  imageUrl      String? @db.VarChar(1000)
  videoUrl      String? @db.VarChar(1000)
  videoStreamId String? @db.VarChar(100)
  thumbnailUrl  String? @db.VarChar(1000)
  r2Key         String? @db.VarChar(500)

  filename   String? @db.VarChar(500)
  mimeType   String? @db.VarChar(200)
  bytes      Int?
  width      Int?
  height     Int?
  durationMs Int?

  status String @default("ready") @db.VarChar(20) // uploading|processing|ready|error

  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  asset           Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([metaIntegrationId, imageHash])
  @@unique([metaIntegrationId, videoId])
  @@index([metaIntegrationId])
  @@index([imageHash])
  @@index([videoId])
  @@index([videoStreamId])
  @@map("meta_media")
}

// ── Campaigns ────────────────────────────────────────────────────────
model MetaCampaign {
  id                String    @id @default(uuid())
  metaIntegrationId String
  /// Returned by Meta API after creation
  metaCampaignId    String    @db.VarChar(100)
  name              String
  objective         String // OUTCOME_TRAFFIC, OUTCOME_SALES etc.
  status            String // PAUSED, ACTIVE, ARCHIVED
  dailyBudget       Int       @default(0) // in smallest currency unit (paise); 0 when budget lives on ad set
  specialAdCategory String? // HOUSING, CREDIT etc. null if none
  metaAdSetId       String?   @db.VarChar(100) // legacy / last-created ad set id
  metaAdId          String?   @db.VarChar(100) // legacy / last-created ad id
  targeting         Json // age, geo, interests, placements
  campaignPresetId  String?
  spendCap          BigInt?
  lifetimeBudget    Int?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt       DateTime? // when status flipped to ACTIVE
  reviewStatus      String? // IN_REVIEW, ACTIVE, DISAPPROVED
  reviewFeedback    String? // rejection reason from Meta if disapproved

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaignPreset  CampaignPreset? @relation(fields: [campaignPresetId], references: [id], onDelete: SetNull)
  creative        MetaCreative?
  adSets          MetaAdSet[]

  @@unique([metaIntegrationId, metaCampaignId])
  @@index([metaIntegrationId])
  @@index([metaCampaignId])
  @@map("meta_campaigns")
}

// ── Creatives ─────────────────────────────────────────────────────────
model MetaCreative {
  id                String  @id @default(uuid())
  metaIntegrationId String
  metaCampaignId    String? @unique // one creative per campaign
  /// Returned by Meta after adcreatives POST
  metaCreativeId    String? @db.VarChar(100)
  /// Returned after adimages POST
  imageHash         String? @db.VarChar(200)
  videoId           String? @db.VarChar(100) // if video ad
  headline          String
  primaryText       String  @db.Text
  description       String?
  ctaType           String // LEARN_MORE, SHOP_NOW etc.
  landingUrl        String

  imageUrl    String? // stored URL of generated image
  imagePrompt String? @db.Text // prompt used to generate image

  videoUrl      String? // stored URL of generated video
  videoPrompt   String? @db.Text // prompt used to generate video
  videoStreamId String? // Stream video ID for management
  thumbnailUrl  String? // Stream auto-generated thumbnail

  aiGenerated         Boolean   @default(true) // always true for your pipeline
  // Compliance
  compliancePassed    Boolean   @default(false)
  complianceFlags     Json? // array of violation strings if any
  complianceCheckedAt DateTime?
  // Approval
  approvedByUser      Boolean   @default(false)
  approvedAt          DateTime?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaign        MetaCampaign?   @relation(fields: [metaCampaignId], references: [id])
  ads             MetaAd[]

  @@unique([metaIntegrationId, metaCreativeId])
  @@index([metaIntegrationId])
  @@index([metaCreativeId])
  @@map("meta_creatives")
}

model MetaAdSet {
  id                String    @id @default(uuid())
  metaIntegrationId String
  campaignId        String
  metaAdSetId       String    @db.VarChar(100)
  name              String?
  status            String?   @db.VarChar(50)
  dailyBudget       Int?
  optimizationGoal  String?   @db.VarChar(100)
  billingEvent      String?   @db.VarChar(50)
  bidStrategy       String?   @db.VarChar(50)
  targeting         Json?
  startTime         DateTime? @db.Timestamptz(3)
  endTime           DateTime? @db.Timestamptz(3)
  adsetPresetId     String?
  lifetimeBudget    Int?
  bidAmount         Int?
  bidConstraints    Json?     @default("{}")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaign        MetaCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adsetPreset     AdsetPreset?    @relation(fields: [adsetPresetId], references: [id], onDelete: SetNull)
  ads             MetaAd[]

  @@unique([metaIntegrationId, metaAdSetId])
  @@index([campaignId])
  @@index([metaIntegrationId])
  @@map("meta_ad_sets")
}

model MetaAd {
  id                String    @id @default(uuid())
  metaIntegrationId String
  adSetId           String
  metaCreativeDbId  String?
  metaAdId          String    @db.VarChar(100)
  name              String?
  status            String?   @db.VarChar(50)
  isSample          Boolean   @default(false) @map("is_sample")
  publishedAt       DateTime? @db.Timestamptz(3)
  reviewStatus      String?   @db.VarChar(50)
  reviewFeedback    String?   @db.Text
  presetId          String?
  scheduleId        String?
  duplicatedFromId  String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  metaIntegration MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  adSet           MetaAdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative        MetaCreative?   @relation(fields: [metaCreativeDbId], references: [id], onDelete: SetNull)
  preset          AdPreset?       @relation(fields: [presetId], references: [id], onDelete: SetNull)
  schedule        AdSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  duplicatedFrom  MetaAd?         @relation("MetaAdDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates      MetaAd[]        @relation("MetaAdDuplicate")

  @@unique([metaIntegrationId, metaAdId])
  @@index([adSetId])
  @@index([metaIntegrationId])
  @@index([presetId])
  @@index([scheduleId])
  @@index([duplicatedFromId])
  @@map("meta_ads")
}

// ── Performance Metrics (polled every 6h) ────────────────────────────
model MetaAdMetrics {
  id             String   @id @default(uuid())
  metaCampaignId String // references MetaCampaign.id (your DB id)
  metaAdId       String   @db.VarChar(100)
  impressions    Int
  clicks         Int
  ctr            Float
  spend          Float // in account currency
  cpc            Float?
  roas           Float?
  hookRate       Float? /// 3-second view rate (or equivalent hook engagement)
  daysRunning    Int?
  statusSignal   String?  @db.VarChar(64) /// e.g. FATIGUE, UNDERPERFORMER, WINNER
  actions        Json? // full actions array from Meta
  datePreset     String // e.g. "last_7d", "last_30d"
  recordedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([metaCampaignId])
  @@index([metaAdId])
  @@map("meta_ad_metrics")
}

// ── Ad presets, scheduling, automation (company-scoped) ─────────────

model CampaignPreset {
  id                  String   @id @default(cuid())
  companyId           String
  name                String   @db.VarChar(120)
  isDefault           Boolean  @default(false)
  objective           String?  @db.VarChar(64)
  status              String?  @db.VarChar(32)
  spendCap            BigInt?
  dailyBudget         BigInt?
  lifetimeBudget      BigInt?
  bidStrategy         String?  @db.VarChar(64)
  specialAdCategories Json?    @default("[]")
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("campaign_presets")
}

model AdsetPreset {
  id             String    @id @default(cuid())
  companyId      String
  name           String    @db.VarChar(120)
  isDefault      Boolean   @default(false)
  dailyBudget    BigInt?
  lifetimeBudget BigInt?
  startTime      DateTime? @db.Timestamptz(3)
  endTime        DateTime? @db.Timestamptz(3)
  bidStrategy    String?   @db.VarChar(64)
  bidAmount      BigInt?
  bidConstraints Json?     @default("{}")
  targeting      Json?     @default("{}")
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adSets  MetaAdSet[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("adset_presets")
}

model AdPreset {
  id              String   @id @default(cuid())
  companyId       String
  name            String   @db.VarChar(255)
  headline        String?  @db.VarChar(500)
  landingPageUrl  String?  @db.VarChar(2000)
  budgetOverride  Float?
  targetAgeMin    Int?
  targetAgeMax    Int?
  targetGenders   String[] @default([])
  targetProfessions String[] @default([])
  pixelIds        String[] @default([])
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metaAds MetaAd[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("ad_presets")
}

model AdSchedule {
  id          String            @id @default(cuid())
  companyId   String
  scheduledAt DateTime          @db.Timestamptz(3)
  status      AdScheduleStatus  @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ads     MetaAd[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([scheduledAt])
  @@map("ad_schedules")
}

model AdAutomationRule {
  id                String    @id @default(cuid())
  companyId         String
  ruleType          RuleType
  isEnabled         Boolean   @default(true)
  threshold         Float?
  window            Int?      /// lookback / evaluation window in days
  lastTriggeredAt   DateTime? @db.Timestamptz(3)
  requiresApproval  Boolean  @default(false)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events  AdAutomationEvent[]

  @@unique([companyId, ruleType])
  @@index([companyId])
  @@map("ad_automation_rules")
}

model AdAutomationEvent {
  id          String         @id @default(cuid())
  companyId   String
  ruleId      String
  adId        String         @db.VarChar(100) /// Meta ad graph id (GID)
  actionTaken AutoActionType
  details     Json           @default("{}")
  approved    Boolean?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rule           AdAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([companyId])
  @@index([ruleId])
  @@index([adId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("ad_automation_events")
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  eventId   String?
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(255)
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event   AdAutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

// ================================================================
// WooCommerce Integration
// ================================================================

/// WooCommerce REST API keys after wc-auth/v1/authorize (or manual dev entry).
model WooCommerceStore {
  id                String               @id @default(cuid())
  companyId         String
  storeUrl          String               @db.VarChar(1000)
  consumerKeyEnc    String               @db.Text
  consumerSecretEnc String               @db.Text
  wcKeyId           Int?
  keyPermissions    String?              @db.VarChar(50)
  status            String               @default("installed") @db.VarChar(50)
  /// Encrypted secret used to verify X-WC-Webhook-Signature when webhooks are registered for this store.
  webhookSecretEnc  String?              @db.Text
  installedAt       DateTime             @default(now()) @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products          WooCommerceProduct[]

  @@unique([companyId, storeUrl])
  @@index([companyId])
  @@map("woocommerce_stores")
}

/// Cached WooCommerce REST catalog row for Shop Intel + Elasticsearch (MCP search).
model WooCommerceProduct {
  id                   String           @id @default(cuid())
  wooCommerceStoreId   String
  companyId            String
  wcProductId          Int
  title                String           @db.VarChar(500)
  /// Normalized for UI parity with Shopify: ACTIVE | DRAFT | ARCHIVED
  status               String           @db.VarChar(50)
  wcStatusRaw          String?          @db.VarChar(50)
  handle               String           @db.VarChar(255)
  totalInventory       Int              @default(0)
  onlineStoreUrl       String?          @db.VarChar(1000)
  priceMinAmount       String?          @db.VarChar(64)
  priceMaxAmount       String?          @db.VarChar(64)
  currencyCode         String?          @db.VarChar(10)
  wcCreatedAt          DateTime         @db.Timestamptz(3)
  wcUpdatedAt          DateTime         @db.Timestamptz(3)
  featuredImageAltText String?          @db.VarChar(500)
  featuredImageHeight  Int?
  featuredImageUrl     String?          @db.VarChar(2000)
  featuredImageWidth   Int?
  description          String?
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)
  store                WooCommerceStore @relation(fields: [wooCommerceStoreId], references: [id], onDelete: Cascade)
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([wooCommerceStoreId, wcProductId])
  @@index([companyId])
  @@index([wooCommerceStoreId])
  @@map("woocommerce_products")
}

/// Opaque state for WooCommerce authorize flow (callback has no session cookies).
model WooCommerceOAuthPending {
  state     String   @id @db.VarChar(128)
  companyId String
  storeUrl  String   @db.VarChar(1000)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
  @@map("woocommerce_oauth_pending")
}

/**
 * ========================================================================
 * CALLS DOMAIN — Leads, Calls, Campaigns, Follow-ups, Conversations
 * ========================================================================
 */

/// A person we might call / message. Manually entered or CSV-imported.
model Lead {
  id            String    @id @default(cuid())
  companyId     String
  name          String    @db.VarChar(255)
  phone         String    @db.VarChar(32)
  email         String?   @db.VarChar(255)
  city          String?   @db.VarChar(120)
  industry      String?   @db.VarChar(120)
  source        String?   @db.VarChar(120)
  /// Optional product context to personalize outbound calls (Shopify/WooCommerce catalog).
  productProvider   IntegrationProvider?
  /// Shopify uses `shopifyGid` (e.g. gid://shopify/Product/123); Woo uses numeric `wcProductId` (stored as string here).
  productExternalId String?              @db.VarChar(255)
  /// Human-friendly product name (used for lookup if no external id is provided).
  productName       String?              @db.VarChar(500)
  /// Optional per-lead question preset for AI calls.
  questionPresetId  String?
  /// Optional per-lead questions override. If non-empty, overrides the preset.
  questionsToAsk    String[]             @default([])
  /// 0-100 heuristic score used to rank leads in the AI pick panel.
  intentScore   Int       @default(0)
  stage         LeadStage @default(NEW)
  /// Loose pointer to a user identifier; no FK yet (user model TBD).
  ownerUserId   String?   @db.VarChar(255)
  campaignId    String?
  tags          String[]  @default([])
  notes         String?
  lastContactAt DateTime?
  timezone      String?   @db.VarChar(64)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceCampaign   Campaign?         @relation("LeadSourceCampaign", fields: [campaignId], references: [id], onDelete: SetNull)
  questionPreset   CallQuestionPreset? @relation(fields: [questionPresetId], references: [id], onDelete: SetNull)
  calls            Call[]
  followUps        FollowUp[]
  conversations    Conversation[]
  campaignMessages CampaignMessage[]
  feedbackTokens   CallFeedbackToken[]
  feedback         CallFeedback[]

  @@index([companyId])
  @@index([companyId, stage])
  @@index([companyId, phone])
  @@index([companyId, createdAt])
  @@index([companyId, questionPresetId])
  @@map("leads")
}

/// One phone call. QUEUED rows are created on outbound dispatch; webhook upserts the rest.
model Call {
  id             String        @id @default(cuid())
  companyId      String
  leadId         String?
  campaignId     String?
  direction      CallDirection @default(OUTBOUND)
  status         CallStatus    @default(QUEUED)
  startedAt      DateTime?
  endedAt        DateTime?
  durationSec    Int?
  connected      Boolean       @default(false)
  outcome        CallOutcome?
  sentiment      Sentiment?
  costCents      Int?
  recordingUrl   String?       @db.VarChar(1000)
  externalCallId String?       @unique @db.VarChar(255)
  dropReason     String?       @db.VarChar(64)
  failureReason  String?       @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign   Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  transcript CallTranscript?
  feedbackTokens CallFeedbackToken[]
  feedback       CallFeedback[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, outcome])
  @@index([companyId, startedAt])
  @@index([leadId])
  @@index([campaignId])
  @@map("calls")
}

/// Post-call AI analysis — summary, turns, objections, next move.
model CallTranscript {
  id                String   @id @default(cuid())
  callId            String   @unique
  summary           String?
  turns             Json?
  /// Question → answer map extracted from transcript turns (keys are agent questions).
  qa                Json?
  objections        String[] @default([])
  aiConfidence      Float?
  suggestedNextMove String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_transcripts")
}

/// One-time token used for collecting post-call customer feedback (public link).
model CallFeedbackToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(128)
  companyId String
  leadId    String?
  callId    String
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, callId])
  @@index([leadId])
  @@index([expiresAt])
  @@map("call_feedback_tokens")
}

/// Customer feedback collected via the post-call public feedback link.
model CallFeedback {
  id        String   @id @default(cuid())
  companyId String
  leadId    String?
  callId    String
  rating    Int
  reason    String?  @db.VarChar(80)
  text      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  call    Call    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, leadId])
  @@index([companyId, callId])
  @@map("call_feedback")
}

/// Outbound campaign. VOICE is fully wired; SMS/WHATSAPP/EMAIL schema-only for now.
model Campaign {
  id              String         @id @default(cuid())
  companyId       String
  name            String         @db.VarChar(255)
  type            CampaignType
  status          CampaignStatus @default(DRAFT)
  /// JSON filter spec evaluated against Lead fields when starting the run.
  audience        Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  replyCount      Int            @default(0)
  conversionCount Int            @default(0)
  createdByUserId String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calls        Call[]
  messages     CampaignMessage[]
  sourcedLeads Lead[]            @relation("LeadSourceCampaign")

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@map("campaigns")
}

/// Per-lead row inside a campaign run. Unified across channels.
model CampaignMessage {
  id          String                @id @default(cuid())
  campaignId  String
  leadId      String
  channel     Channel
  status      CampaignMessageStatus @default(QUEUED)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  replyAt     DateTime?
  metadata    Json?
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
  @@map("campaign_messages")
}

/// Scheduled re-engagement reminder.
model FollowUp {
  id                String           @id @default(cuid())
  companyId         String
  leadId            String
  reason            FollowUpReason   @default(OTHER)
  customReason      String?          @db.VarChar(255)
  dueAt             DateTime
  priority          FollowUpPriority @default(MEDIUM)
  status            FollowUpStatus   @default(PENDING)
  lastInteractionAt DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status, dueAt])
  @@index([companyId, priority])
  @@index([leadId])
  @@map("follow_ups")
}

/// A per-lead interaction thread (v1: one row per VOICE call; other channels reuse the model later).
model Conversation {
  id            String     @id @default(cuid())
  companyId     String
  leadId        String
  channel       Channel    @default(VOICE)
  summary       String?
  sentiment     Sentiment?
  intent        String?    @db.VarChar(120)
  keywords      String[]   @default([])
  lastMessageAt DateTime?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead     Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@unique([companyId, leadId, channel])
  @@index([companyId])
  @@index([companyId, lastMessageAt])
  @@index([leadId])
  @@map("conversations")
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  text           String
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

/// Idempotency record for calling-agent webhook deliveries.
model WebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique @db.VarChar(128)
  source     String   @db.VarChar(64)
  companyId  String?
  eventType  String   @db.VarChar(64)
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([source, eventType])
  @@map("webhook_events")
}


// ========================================================================
// SUBSCRIPTION DOMAIN — Billing, Plans, Add-ons
// ========================================================================

/// Subscription and billing record for each company.
model Subscription {
  id         String             @id @default(cuid())
  companyId  String             @unique

  /// External provider subscription ID (e.g. Razorpay sub_XXXX, Stripe sub_XXXX)
  externalId String?            @db.VarChar(255) @map("external_id")
  provider   String?            @default("razorpay") @db.VarChar(50)

  plan       SubscriptionPlan   @default(STARTER)
  status     SubscriptionStatus @default(PENDING)
  cycle      BillingCycle       @default(MONTHLY) 

  /// Price charged in smallest currency unit (paise for INR, cents for USD)
  priceAmount Int               @default(4900) @map("price_amount") // 49.00 USD in cents
  currency    String            @default("USD") @db.VarChar(10)

  /// Quota limits (set by plan tier; can be overridden for custom deals)
  radarScansQuota         Int   @default(40)  @map("radar_scans_quota")
  bountyGeneratorQuota    Int   @default(30)  @map("bounty_generator_quota")
  seoPageGenerationQuota  Int   @default(20)  @map("seo_page_generation_quota")
  rivalsAnalysisQuota     Int   @default(10)  @map("rivals_analysis_quota")

  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz(3)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)

  /// Raw webhook payload storage for reconciliation / debugging
  metadata   Json?     @default("{}")

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  usage      SubscriptionUsage[]
  addOns     SubscriptionAddOn[]

  @@index([companyId])
  @@index([status])
  @@index([plan])
  @@index([externalId])
  @@map("subscriptions")
}

/// Single-use coupon codes for Dealify plan signup (100% off, 3-year term).
model SubscriptionCoupon {
  id                  String           @id @default(cuid())
  code                String           @unique @db.VarChar(64)
  plan                SubscriptionPlan
  expiresAt           DateTime?        @db.Timestamptz(3)
  redeemedAt          DateTime?        @db.Timestamptz(3)
  redeemedByCompanyId String?          @map("redeemed_by_company_id")
  redeemedByCompany   Company?         @relation(fields: [redeemedByCompanyId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([plan, redeemedAt])
  @@map("subscription_coupons")
}

/// Active add-ons attached to a subscription.
model SubscriptionAddOn {
  id             String          @id @default(cuid())
  subscriptionId String          @map("subscription_id")

  addOnType      AddOnType       @map("add_on_type")

  /// External provider add-on ID (e.g. Razorpay addon_XXXX)
  externalId     String?         @db.VarChar(255) @map("external_id")

  /// Price in smallest currency unit
  priceAmount    Int             @map("price_amount")
  currency       String          @default("USD") @db.VarChar(10)

  isActive       Boolean         @default(true) @map("is_active")
  activatedAt    DateTime        @default(now()) @map("activated_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)

  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, addOnType])  // one of each add-on type per subscription
  @@index([subscriptionId])
  @@index([addOnType])
  @@map("subscription_add_ons")
}

model SubscriptionUsage {
  id             String   @id @default(cuid())
  companyId      String   @unique  // one active usage record per company
  subscriptionId String   @map("subscription_id")

  /// Resets to 0 at the start of each billing period
  radarScansUsed        Int @default(0) @map("radar_scans_used")
  bountyGeneratorUsed   Int @default(0) @map("bounty_generator_used")
  seoPageGenerationUsed Int @default(0) @map("seo_page_generation_used")
  rivalsAnalysisUsed    Int @default(0) @map("rivals_analysis_used")

  /// The period this usage belongs to
  periodStart DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([subscriptionId])
  @@map("subscription_usage")
