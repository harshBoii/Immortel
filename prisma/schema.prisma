generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Parent tenant for multi-company (HQ) accounts. Optional on [`Company`] for standalone or external rivals.
model Organization {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  username  String    @unique
  password  String
  companies Company[]

  @@map("organizations")
}

model Company {
  id                        String        @id @default(cuid())
  name                      String        @db.VarChar(255)
  slug                      String        @unique @db.VarChar(255)
  description               String?
  logoUrl                   String?       @db.VarChar(1000)
  website                   String?       @db.VarChar(500)
  /// Canonical domain (no scheme/path). Used for rival lookup / dedupe.
  domain                    String?       @db.VarChar(255)
  /// Requested CMS integrations collected at onboarding (e.g. ["Webflow","Other: Custom"])
  requestedCmsIntegrations  String[]      @default([])
  /// Captured during onboarding when WordPress is selected; later reconciled into `WordPressIntegration`.
  wordpressRequestedSiteUrl String?       @db.VarChar(1000)
  /// Auth fields are nullable to support “external” companies (e.g. rivals) that are not login accounts.
  email                     String?       @unique @db.VarChar(255)
  userName                  String?       @unique @db.VarChar(255)
  password                  String?       @db.VarChar(255)
  isExternal                Boolean       @default(false)
  /// When true, this company row is the HQ login for [`organizationId`] (org-wide dashboard + tenant switch).
  isOrg                     Boolean       @default(false) @map("is_org")
  organizationId            String?       @map("organization_id")
  organization              Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt                 DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @db.Timestamptz(3)

  // Background job fields
  autoRefreshAt        DateTime?  @map("auto_refresh_at")
  autoRefreshFrequency Frequency? @default(MONTHLY) @map("auto_refresh_frequency")
  autoRefreshLastRunAt DateTime?  @map("auto_refresh_last_run_at")

  // Subscription fields
  subscription Subscription?
  subscriptionUsage SubscriptionUsage?
  redeemedCoupons SubscriptionCoupon[]

  // subscriptionId        String?            @map("subscription_id")
  // subscriptionStatus    SubscriptionStatus @default(PENDING) @map("subscription_status")
  // subscriptionCreatedAt DateTime?          @map("subscription_created_at")
  // subscriptionUpdatedAt DateTime?          @map("subscription_updated_at")

  CallFeedbacks           CallFeedback[]
  CallFeedbackTokens      CallFeedbackToken[]
  metaIntegration         MetaIntegration?
  videoGenerationJobs    videoGenerationJob[]
  aeoGenerationProfiles   AeoGenerationProfile[]
  aeoPages                AeoPage[]
  assetIntelligence       AssetIntelligence[]
  assets                  Asset[]
  brandEntity             BrandEntity?
  citationBounties        CitationBounty[]
  branding                CompanyBranding?
  integrationCms          CompanyIntegrationCms[]
  contentClusters         ContentCluster[]
  geoDataSources          GeoDataSource[]
  Citations               Citation[]
  LlmRadarMetrics         LlmRadarMetric[]
  llmTopics               LlmTopic[]
  microAssets             MicroAsset[]
  shopifyProducts         ShopifyProduct[]
  shopifyShops            ShopifyShop[]
  shopifyBlogChannels     ShopifyBlogChannel[]
  webinars                Webinar[]
  radarAssumption         RadarAssumption?
  llmPromptMetrics        LlmPromptMetric[]
  wordpressIntegration    WordPressIntegration?
  woocommerceStores       WooCommerceStore[]
  woocommerceOAuthPending WooCommerceOAuthPending[]
  woocommerceProducts     WooCommerceProduct[]
  plan                    CompanyPlan?
  rivals                  CompanyRival[]            @relation("CompanyRivals")
  rivaledBy               CompanyRival[]            @relation("CompanyRivalTargets")

  // Calls domain
  leads         Lead[]
  calls         Call[]
  campaigns     Campaign[]
  followUps     FollowUp[]
  conversations Conversation[]
  webhookEvents WebhookEvent[]
  callQuestionPresets CallQuestionPreset[]
  callConfig CallConfig?

  bulkUploads         BulkUpload[]
  assetBuckets        AssetBucket[]
  adAutomationRules   AdAutomationRule[]
  adAutomationEvents  AdAutomationEvent[]
  adPresets           AdPreset[]
  adSchedules         AdSchedule[]
  adsetPresets        AdsetPreset[]
  campaignPresets     CampaignPreset[]
  notifications       Notification[]

  @@index([slug])
  @@index([organizationId])
  @@map("companies")
}

model CompanyPlan {
  id               String   @id @default(cuid())
  companyId        String   @unique
  maxRivalsAllowed Int      @default(10)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_plans")
}

/// Per-company preset question lists used to guide AI calls.
model CallQuestionPreset {
  id        String   @id @default(cuid())
  companyId String
  name      String   @db.VarChar(120)
  /// One default preset per company (enforced by app logic).
  isDefault Boolean  @default(false)
  questions String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads   Lead[]

  @@index([companyId])
  @@index([companyId, isDefault])
  @@map("call_question_presets")
}

/// Per-company defaults for outbound AI calls (used when UI omits fields).
model CallConfig {
  id        String   @id @default(cuid())
  companyId String   @unique

  /// Default language slug (matches the calling-agent contract, e.g. "english").
  languageMode String  @default("english") @db.VarChar(32)
  /// Default voice mode: "speed" | "quality" | "eleven_v3".
  voiceMode    String  @default("speed")   @db.VarChar(32)
  /// Default ElevenLabs voice ID (or compatible provider voice id).
  voiceId      String? @db.VarChar(255)

  /// Default LLM provider (e.g. "groq", "openai", "gemini"...).
  llmProvider String @default("groq") @db.VarChar(32)

  /// Optional persona overrides (if null, calling-agent chooses its defaults).
  agentName       String? @db.VarChar(120)
  /// "Tone" / persona / role text.
  agentTone       String? @db.VarChar(500)
  systemPrompt    String?
  openingGreeting String? @db.VarChar(500)

  /// Optional TTS provider toggle.
  useSarvamTts  Boolean @default(false)
  sarvamSpeaker String? @db.VarChar(32)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("call_configs")
}

model CompanyRival {
  id             String   @id @default(cuid())
  companyId      String
  rivalCompanyId String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  company        Company  @relation("CompanyRivals", fields: [companyId], references: [id], onDelete: Cascade)
  rivalCompany   Company  @relation("CompanyRivalTargets", fields: [rivalCompanyId], references: [id], onDelete: Cascade)

  @@unique([companyId, rivalCompanyId])
  @@index([companyId])
  @@index([rivalCompanyId])
  @@map("company_rivals")
}

model CompanyIntegrationCms {
  id                 String              @id @default(cuid())
  companyId          String
  provider           IntegrationProvider @default(Shopify)
  apiKey             String?             @db.VarChar(500)
  apiSecret          String?             @db.VarChar(500)
  scopes             String?
  appUrl             String?             @db.VarChar(2000)
  connectUrl         String?             @db.VarChar(2000)
  /// Normalized *.myshopify.com — used to resolve company + CMS credentials before shop is installed
  expectedShopDomain String?             @unique @db.VarChar(255)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId])
  @@map("company_integration_cms")
}

model BrandEntity {
  id                  String                 @id @default(cuid())
  companyId           String                 @unique
  canonicalName       String?                @db.VarChar(255)
  aliases             String[]               @default([])
  entityType          String                 @default("Organization") @db.VarChar(100)
  oneLiner            String?                @db.VarChar(500)
  about               String?
  industry            String?                @db.VarChar(100)
  category            String?                @db.VarChar(100)
  headquartersCity    String?                @db.VarChar(100)
  headquartersCountry String?                @db.VarChar(100)
  foundedYear         Int?
  employeeRange       String?                @db.VarChar(50)
  businessModel       String?                @db.VarChar(50)
  topics              String[]               @default([])
  keywords            String[]               @default([])
  targetAudiences     String[]               @default([])
  authorityScore      Float?
  citationCount       Int                    @default(0)
  lastCrawledAt       DateTime?              @db.Timestamptz(3)
  completenessScore   Float                  @default(0)
  lastEnrichedAt      DateTime?              @db.Timestamptz(3)
  enrichmentSource    String?                @db.VarChar(50)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  generationProfiles  AeoGenerationProfile[]
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intelligence        EntityIntelligence?
  offerings           EntityOffering[]
  sameAsLinks         EntitySameAsLink[]

  @@index([industry])
  @@index([completenessScore])
  @@map("brand_entities")
}

model EntityIntelligence {
  id               String      @id @default(cuid())
  entityId         String      @unique
  productDocs      String?
  marketResearch   String?
  customerFeedback String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  entity           BrandEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("entity_intelligence")
}

model EntitySameAsLink {
  id         String      @id @default(cuid())
  entityId   String
  platform   String      @db.VarChar(100)
  url        String      @db.VarChar(1000)
  verified   Boolean     @default(false)
  verifiedAt DateTime?   @db.Timestamptz(3)
  verifiedBy String?     @db.VarChar(50)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  entity     BrandEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, platform])
  @@index([entityId])
  @@index([platform])
  @@map("entity_same_as_links")
}

model EntityOffering {
  id              String       @id @default(cuid())
  entityId        String
  name            String       @db.VarChar(255)
  slug            String       @db.VarChar(255)
  description     String?
  offeringType    OfferingType @default(PRODUCT)
  url             String?      @db.VarChar(1000)
  keywords        String[]     @default([])
  useCases        String[]     @default([])
  targetAudiences String[]     @default([])
  isPrimary       Boolean      @default(false)
  isActive        Boolean      @default(true)
  differentiators String[]     @default([])
  competitors     String[]     @default([])
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  entity          BrandEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, slug])
  @@index([entityId])
  @@index([offeringType])
  @@index([isPrimary])
  @@index([isActive])
  @@map("entity_offerings")
}

model CompanyBranding {
  id             String   @id @default(cuid())
  companyId      String   @unique
  logoUrl        String?  @db.VarChar(1000)
  faviconUrl     String?  @db.VarChar(1000)
  banner         String?  @db.VarChar(1000)
  themeMusic     String?  @db.VarChar(1000)
  primaryColor   String   @default("#D7765A") @db.VarChar(20)
  secondaryColor String   @default("#8B5CF6") @db.VarChar(20)
  bgColor        String   @default("#141414") @db.VarChar(20)
  surfaceColor   String   @default("#181818") @db.VarChar(20)
  textColor      String   @default("#FFFFFF") @db.VarChar(20)
  companyAddress String?  @default("123 Main St, San Francisco, CA") @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_branding")
}

model BulkUpload {
  id        String           @id @default(cuid())
  companyId String
  name      String           @db.VarChar(255)
  status    BulkUploadStatus @default(PROCESSING)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets       Asset[]
  assetBuckets AssetBucket[]

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("bulk_uploads")
}

model AssetBucket {
  id           String     @id @default(cuid())
  companyId    String
  bulkUploadId String
  label        String     @db.VarChar(255)
  bucketType   BucketType
  bucketValue  String     @db.VarChar(255)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload BulkUpload @relation(fields: [bulkUploadId], references: [id], onDelete: Cascade)
  assets     Asset[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@map("asset_buckets")
}

model AssetWarning {
  id          String             @id @default(cuid())
  assetId     String
  warningType AssetWarningType
  detail      String?            @db.Text
  resolved    Boolean            @default(false)
  resolution  WarningResolution?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([assetId, resolved])
  @@map("asset_warnings")
}

model Asset {
  id                 String              @id @default(cuid())
  assetType          AssetType
  title              String              @db.VarChar
  filename           String              @db.VarChar
  originalSize       BigInt
  status             AssetStatus         @default(UPLOADING)
  r2Key              String              @db.VarChar(500)
  r2Bucket           String              @db.VarChar(255)
  resolution         String?             @db.VarChar(20)
  mimeType           String?             @db.VarChar(100)
  duration           Int?
  fps                Int?
  codec              String?             @db.VarChar(50)
  streamId           String?             @unique @db.VarChar(255)
  playbackUrl        String?
  thumbnailUrl       String?
  pageCount          Int?
  tags               String[]            @default([])
  metadata           Json                @default("{}")
  uploadSource       UploadSource        @default(NATIVE)
  companyId          String
  bulkUploadId       String?
  assetBucketId      String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  intelligenceStatus IntelligenceStatus?
  aeoPageSources     AeoPageSource[]
  description        AssetDescription?
  intelligence       AssetIntelligence[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bulkUpload         BulkUpload?         @relation(fields: [bulkUploadId], references: [id], onDelete: SetNull)
  assetBucket        AssetBucket?        @relation(fields: [assetBucketId], references: [id], onDelete: SetNull)
  warnings           AssetWarning[]
  geoDataSource      GeoDataSource?
  microAssets        MicroAsset[]
  streamQueueItems   StreamQueue[]
  webinars           Webinar[]
  metaMedia          MetaMedia?
  videoGenerationJobs videoGenerationJob[]

  @@index([companyId])
  @@index([bulkUploadId])
  @@index([assetBucketId])
  @@index([assetType])
  @@index([status])
  @@index([uploadSource])
  @@index([assetType, status])
  @@index([assetType, companyId])
  @@index([createdAt(sort: Desc)])
  @@index([intelligenceStatus])
  @@map("assets")
}

model StreamQueue {
  id          String              @id @default(cuid())
  assetId     String
  r2Key       String              @db.VarChar(500)
  r2Bucket    String              @db.VarChar(255)
  status      StreamQueueStatus   @default(PENDING)
  priority    StreamQueuePriority @default(NORMAL)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(3)
  lastError   String?
  streamId    String?             @db.VarChar(255)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?           @db.Timestamptz(3)
  completedAt DateTime?           @db.Timestamptz(3)
  asset       Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([assetId])
  @@map("stream_queue")
}

model videoGenerationJob {
  id              String   @id @default(cuid())
  companyId       String
  createdByUserId String?  @db.VarChar(255)
  script          String
  avatarId        String   @db.VarChar(255)
  voiceId         String   @db.VarChar(255)
  customAvatarId  String?  @db.VarChar(255)
  customVoiceId   String?  @db.VarChar(255)
  heygenVideoId   String?  @unique @db.VarChar(255)
  heygenStatus    String   @default("queued") @db.VarChar(50)
  heygenError     String?
  assetId         String?
  streamUid       String?  @db.VarChar(255)
  r2Key           String?  @db.VarChar(500)
  downloadUrl     String?  @db.VarChar(2000)
  playbackUrl     String?  @db.VarChar(2000)
  thumbnailUrl    String?  @db.VarChar(2000)
  progressMessage String?  @db.VarChar(500)
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, heygenStatus])
  @@index([assetId])
  @@map("video_generation_jobs")
}

model UploadSession {
  id            String   @id @default(cuid())
  uploadId      String   @db.VarChar(255)
  key           String   @db.VarChar(500)
  fileName      String   @db.VarChar(255)
  fileSize      BigInt
  fileType      String   @db.VarChar(200)
  totalParts    Int
  uploadedParts Int[]    @default([])
  status        String   @db.VarChar(50)
  campaignId    String?  @db.VarChar(255)
  uploadedBy    String?  @db.VarChar(255)
  metadata      String?
  expiresAt     DateTime @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([uploadedBy])
  @@index([campaignId])
  @@map("upload_sessions")
}

model AssetDescription {
  id         String   @id @default(cuid())
  assetId    String   @unique
  content    String
  seoTitle   String?  @db.VarChar(500)
  seoSummary String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_descriptions")
}

model AssetIntelligence {
  id                String          @id @default(cuid())
  assetId           String
  language          String?         @db.VarChar(10)
  contentType       String?         @db.VarChar(100)
  durationSeconds   Int?
  theme             String?         @db.VarChar(255)
  sentiment         String?         @db.VarChar(50)
  intensityScore    Float?
  spiritualElements Boolean         @default(false)
  titlePrimary      String?         @db.VarChar(500)
  shortSummary      String?
  longDescription   String?
  tags              String[]        @default([])
  tone              String[]        @default([])
  topics            String[]        @default([])
  targetAudience    String[]        @default([])
  bestPlatforms     String[]        @default([])
  visualContext     String[]        @default([])
  videoGenres       String[]        @default([])
  titleVariants     Json?           @default("{}")
  chapters          Json?           @default("[]")
  shortsHooks       Json?           @default("[]")
  clipfoxInsights   Json?           @default("[]")
  modelVersion      String?         @db.VarChar(50)
  confidence        Float?
  processedAt       DateTime        @default(now()) @db.Timestamptz(3)
  companyId         String
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  aeoPageSources    AeoPageSource[]
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([companyId])
  @@index([language])
  @@index([sentiment])
  @@index([theme])
  @@index([contentType])
  @@index([spiritualElements])
  @@index([processedAt(sort: Desc)])
  @@map("asset_intelligence")
}

model MicroAsset {
  id          String           @id @default(cuid())
  assetId     String
  title       String           @db.VarChar(500)
  startTime   Float
  endTime     Float
  hook        String?
  editingIdea String?
  description String?
  thumbnail   String?          @db.VarChar(1000)
  status      MicroAssetStatus @default(DRAFT)
  category    String?          @db.VarChar(100)
  tags        String[]         @default([])
  aiGenerated Boolean          @default(false)
  confidence  Float?
  companyId   String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  approved_at DateTime?        @db.Timestamptz(3)
  is_approved Boolean          @default(false)
  shortType   ContentStyle?    @default(CASUAL)
  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([companyId])
  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([is_approved])
  @@map("micro_assets")
}

model Webinar {
  id                 String    @id @default(cuid())
  title              String    @db.VarChar(255)
  description        String?
  assetId            String?
  companyId          String
  scheduledAt        DateTime? @db.Timestamptz(3)
  isRecurring        Boolean   @default(false)
  recurringDayOfWeek String?   @db.VarChar(20)
  recurringTime      String?   @db.VarChar(10)
  timeZone           String?   @db.VarChar(50)
  status             String    @default("DRAFT") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  approved_at        DateTime? @db.Timestamptz(3)
  is_approved        Boolean   @default(false)
  asset              Asset?    @relation(fields: [assetId], references: [id])
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([assetId])
  @@index([scheduledAt])
  @@index([is_approved])
  @@map("webinars")
}

model ContentCluster {
  id           String    @id @default(cuid())
  companyId    String
  name         String    @db.VarChar(255)
  slug         String    @db.VarChar(255)
  description  String?
  pillarPageId String?   @unique
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  pages        AeoPage[] @relation("ClusterPages")
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pillarPage   AeoPage?  @relation("PillarPage", fields: [pillarPageId], references: [id])

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("content_clusters")
}

model AeoPage {
  id                String        @id @default(cuid())
  companyId         String
  slug              String        @db.VarChar(255)
  locale            String        @default("en") @db.VarChar(10)
  pageType          AeoPageType   @default(DEFINITION)
  status            AeoPageStatus @default(DRAFT)
  title             String        @db.VarChar(500)
  description       String
  facts             Json          @default("[]")
  faq               Json          @default("[]")
  claims            Json          @default("[]")
  summary           Json          @default("{}")
  knowledgeGraph    Json          @default("{}")
  seoTitle          String?       @db.VarChar(500)
  seoDescription    String?
  canonicalUrl      String?       @db.VarChar(1000)
  /// Shopify Admin API GID for the blog article when published via approve-shopify
  shopifyArticleGid String?       @db.VarChar(255)
  clusterId         String?
  publishedAt       DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  llm_prompt_id String?
  llm_prompt    Prompt? @relation(fields: [llm_prompt_id], references: [id])

  llm_topic_id String?
  llm_topic    LlmTopic? @relation(fields: [llm_topic_id], references: [id])

  generationProfiles AeoGenerationProfile[]
  sources            AeoPageSource[]
  cluster            ContentCluster?        @relation("ClusterPages", fields: [clusterId], references: [id])
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  citationBounties   CitationBounty?
  pillarFor          ContentCluster?        @relation("PillarPage")
  aeo_pages_A        AeoPage[]              @relation("RelatedAeoPages")
  aeo_pages_B        AeoPage[]              @relation("RelatedAeoPages")

  @@unique([companyId, slug, locale])
  @@index([companyId])
  @@index([status])
  @@index([pageType])
  @@index([clusterId])
  @@index([companyId, status])
  @@index([publishedAt(sort: Desc)])
  @@map("aeo_pages")
}

model AeoGenerationProfile {
  id                     String       @id @default(cuid())
  companyId              String
  brandEntityId          String?
  baseUrl                String       @db.VarChar(1000)
  locale                 String       @default("en") @db.VarChar(10)
  clusterId              String?      @db.VarChar(255)
  existingSlugs          String[]     @default([])
  defaultPageType        AeoPageType  @default(COMPARISON)
  defaultQuery           String?
  label                  String?      @db.VarChar(255)
  slug                   String?      @db.VarChar(255)
  lastGeneratedAeoPageId String?
  lastRunAt              DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  brandEntity            BrandEntity? @relation(fields: [brandEntityId], references: [id])
  company                Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lastGeneratedAeoPage   AeoPage?     @relation(fields: [lastGeneratedAeoPageId], references: [id])

  @@index([companyId])
  @@index([brandEntityId])
  @@index([defaultPageType])
  @@map("aeo_generation_profiles")
}

model AeoPageSource {
  id                String             @id @default(cuid())
  pageId            String
  assetId           String?
  intelligenceId    String?
  contributionScore Float?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  asset             Asset?             @relation(fields: [assetId], references: [id])
  intelligence      AssetIntelligence? @relation(fields: [intelligenceId], references: [id])
  page              AeoPage            @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([assetId])
  @@map("aeo_page_sources")
}

model CitationBounty {
  id                String           @id @default(cuid())
  companyId         String
  query             String
  intent            String?          @db.VarChar(255)
  pageType          AeoPageType
  confidence        Float
  difficulty        BountyDifficulty @default(EASY)
  estimatedReach    Int?
  /// estimatedReach × (conversionRate ?? default) × (avgOrderValue ?? company AOV)
  estimatedRevenue  Float?
  /// Site / funnel conversion (e.g. 0.025); defaults applied in app when null
  conversionRate    Float?
  /// Snapshot AOV used for revenue estimate (often from Shopify catalog median)
  avgOrderValue     Float?
  suggestedCluster  String?          @db.VarChar(255)
  status            BountyStatus     @default(OPEN)
  huntedAt          DateTime?        @db.Timestamptz(3)
  /// When generated content was published (e.g. AEO page go-live)
  publishedAt       DateTime?        @db.Timestamptz(3)
  aeoPageId         String?          @unique
  generationContext Json             @default("{}")
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  aeoPage           AeoPage?         @relation(fields: [aeoPageId], references: [id])
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([confidence])
  @@index([difficulty])
  @@index([companyId, status])
  @@index([companyId, status, confidence])
  @@map("citation_bounties")
}

model GeoDataSource {
  id               String        @id @default(cuid())
  companyId        String
  sourceType       GeoSourceType
  label            String        @db.VarChar(255)
  assetId          String?       @unique
  rawContent       String?
  processedContent String?
  isActive         Boolean       @default(true)
